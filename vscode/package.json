{
  "name": "genshen-skin-cp3",
  "displayName": "原神CP3 — 米提亚×奥黛塔×沃雅妮莎",
  "description": "原神 CP 壁纸套件1: 单张样式壁纸一键切换 · 桌面桌宠 · 多 IDE 皮肤",
  "version": "0.1.0",
  "publisher": "wp666",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/WPH666-py/Genshen-skin-CP3.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "genshencp3.openGallery",
        "title": "原神CP3: 打开皮肤画廊"
      },
      {
        "command": "genshencp3.setCard",
        "title": "原神CP3: 卡片式(模糊背景 + 居中卡片)"
      },
      {
        "command": "genshencp3.setCover",
        "title": "原神CP3: 满屏(cover 铺满整屏)"
      },
      {
        "command": "genshencp3.setShowall",
        "title": "原神CP3: 完整(不裁切, 两侧留边)"
      },
      {
        "command": "genshencp3.setRandom",
        "title": "原神CP3: 随机换一张"
      },
      {
        "command": "genshencp3.openSwitcher",
        "title": "原神CP3: 打开壁纸切换器"
      },
      {
        "command": "genshencp3.startPet",
        "title": "原神CP3: 启动桌面桌宠"
      },
      {
        "command": "genshencp3.generateAll",
        "title": "原神CP3: 生成全部样式(含 JetBrains 背景图)"
      },
      {
        "command": "genshencp3.showInfo",
        "title": "原神CP3: 环境自检"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "genshencp3",
          "title": "原神CP3",
          "icon": "media/genshencp3.svg"
        }
      ]
    },
    "views": {
      "genshencp3": [
        {
          "id": "genshencp3.gallery",
          "name": "皮肤画廊",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Genshin Skin CP1",
      "properties": {
        "genshencp3.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径。留空自动查找 python / python3。"
        },
        "genshencp3.repoPath": {
          "type": "string",
          "default": "",
          "description": "仓库路径(含 src/genshen_skin_cp3 或 tools/wallpaper.py)。留空自动查找 pip 安装与常见克隆位置。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node prepack.js"
  }
}
